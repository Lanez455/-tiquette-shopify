{
  "name": "etiquettes-shopify",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "shopify app dev",
    "deploy": "shopify app deploy",
    "start": "react-router-serve ./build/server/index.js",
    "postinstall": "prisma generate",
    "setup": "prisma generate && prisma migrate deploy",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test": "vitest run",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/client": "^6.19.0",
    "@react-router/fs-routes": "^7.18.0",
    "@react-router/node": "^7.18.0",
    "@react-router/serve": "^7.18.0",
    "@shopify/app-bridge-react": "^4.2.0",
    "@shopify/shopify-app-react-router": "^3.0.2",
    "@shopify/shopify-app-session-storage-prisma": "^11.0.1",
    "bwip-js": "^4.11.0",
    "dejavu-fonts-ttf": "^2.37.3",
    "isbot": "^5.1.0",
    "pdf-lib": "^1.17.1",
    "prisma": "^6.19.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.18.0"
  },
  "devDependencies": {
    "@react-router/dev": "^7.18.0",
    "@shopify/app-bridge-types": "^0.7.0",
    "@shopify/polaris-types": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@zxing/library": "^0.21.3",
    "pngjs": "^7.0.0",
    "typescript": "^5.8.0",
    "vite": "^6.4.0",
    "vite-tsconfig-paths": "^5.1.0",
    "vitest": "^3.2.0"
  }
}
