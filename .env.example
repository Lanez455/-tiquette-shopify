# Rempli automatiquement par `shopify app dev`. En production, à définir sur l'hébergeur.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SCOPES=read_products,write_products,read_inventory,write_inventory,read_locations,read_inventory_purchase_orders,read_inventory_transfers
DATABASE_URL=file:dev.sqlite
# Abonnements de test (non facturés) tant que cette variable ne vaut pas « false »
BILLING_TEST=true
# Adresse de support affichée sur la page /confidentialite
SUPPORT_EMAIL=
